# Timezone usado em toda a aplicação (janelas, cortes, timestamps)
TIMEZONE=America/Sao_Paulo

# Frete: taxa_base + preco_por_km * distancia_km (valores em CENTAVOS)
SHIPPING_BASE_FEE_CENTS=500
SHIPPING_PRICE_PER_KM_CENTS=150
SHIPPING_MAX_DELIVERY_RADIUS_KM=8

# Endereço/coordenadas da loja (placeholder — trocar pelo endereço real via env, sem tocar em código)
STORE_ADDRESS="Rua Augusta, 1000 - Consolação, São Paulo - SP"
STORE_LAT=-23.5558
STORE_LON=-46.6620

# Janelas de entrega e corte (formato HH:mm, hora local do TIMEZONE acima)
WINDOW_12H_TIME=12:00
WINDOW_12H_CUTOFF=11:40
WINDOW_16H_TIME=16:00
WINDOW_16H_CUTOFF=15:40

# Canal de mensagens ativo: simulator-cli | simulator-web (ver README > "Canal de mensagens")
MESSAGING_ADAPTER=simulator-cli
WEB_SIMULATOR_PORT=3000

# Caminho do arquivo SQLite (pedidos e conversas). Use ":memory:" para não persistir.
DB_PATH=./data/app.db

# OpenRouteService (geocoding, directions/matrix, optimization)
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
# Perfil de roteamento ORS. Não existe perfil de moto — "driving-car" é a aproximação usada.
ORS_PROFILE=driving-car
# Restringe geocoding a um país (ISO 3166-1), evita candidatos fora do Brasil
ORS_GEOCODING_BOUNDARY_COUNTRY=BR
ORS_TIMEOUT_MS=5000
ORS_RETRIES=2

# Resolução de endereço: confiança mínima do Pelias (0..1) para considerar um
# candidato plausível, e máximo de opções oferecidas ao cliente quando há mais de uma
ADDRESS_MIN_CONFIDENCE=0.4
ADDRESS_MAX_CANDIDATES=3
